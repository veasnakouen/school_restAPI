## TodoApi > Exceptions > GlobalExceptionHandler{
	private readonly Iloger<GlobalExceptionHandler> _logger;
	public GlobalExceptionhanlder(ILogger<GlobalExceptionHandler> logger){
		_logger = logger;
	}

	public async ValueTask<bool> TryHandlerAsync(HttpContext httpContext,Exception exception,CncellationToken cancellationToken){
		_logger.logError(exception,exception.Message);
		var response = new ErrorResponse{
			message = exception.Message;
		}
		switch (exception){
			case BadhttpRequestException:
				response.StatusCode = (int)httpStatusCode.BadRequest;
				response.Title = exception.GetType().Name;
				break;
			case default:
				response.StatusCode = (int)HttpStatusCode.interlServerError;
				response.Title = "Internal Server Error";
				break;
		}
		httpContext.Reponse.Statuscode = response.Statuscode;
		await httpcontext.Reponse.WriteAsJsonAsync(response,cancellationToken);

		return true;
		
	}
}
