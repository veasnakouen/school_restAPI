//Implementation
* Infrastructure > Repository > BaseRepository<T> : IBaseRepository<T> where T: class
	{
		private readonly Dbcontext _context;
		private readonly DbSet<T> _dbSet; 
		
		public BaseRepository(Dbcontext context){
			_context = context;
			_dbSet = _context.Set<T>();
		}

		public async Task<T> AddAsync(T entity){
			await _dbSet.AddAsync(entity);
			await _context.SaveChangeAsync();
			return entity;
		}
	
		public async Task<IEnumerable<T>> GetAllAsync(){
			IQueryable<T> query = _dbSet.AsNotTracking();
			if(typeof(T) == typeof(TodoItem)){
				query = query.Include(t=>((TodoITem)(object)t).TodoCategory);
			}
			return await query.ToListAsync();
		}
		
		public async Task<T> GetByIdAsync(int id){
			return await _dbSet.FindAsync(id);
		}
		
		public async Task<T> DeleteAsync(T entity){
			 _dbSet.Remove(entity);
			await _context.SaveChangeAsync();
			return entity;
		}
		
		public async Task<T> UpdateAsync(T entity){
			_dbSet.Attach(entity)
			_context.Entry(entity).State = EntityState.Modeified;
			await _context.SaveChangeAsync();
			return entity;
		}

		public Task<IEumerable<T>> SearchTodoAsync(string searchTerm){
			if(typeof(T) == typeof(TodoItem)){
				return await _contex.Set<TodoItem>()
					.Include(t=>t.TodoCategory)
					.Where(b=>EF.Functions.Like(b.Title,$"%{searchTerm}%"))
					.Cast<T>()
					.ToListAsync();
			}else{
				throw new InvalidOperationException("Search Only For TodoItems!");
			}
		}
	}
 	
